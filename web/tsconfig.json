{
	// TypeScript stays on 6.x on purpose. `typescript@latest` is 7.0.2 — the
	// native compiler — and what it offers is compile speed, which this project
	// does not feel: `svelte-check` covers 4,213 files in well under a second.
	// The tools that would have to accept it still refuse it, and their own peer
	// ranges are the test rather than anyone's recollection. On 11 October 2026:
	//     svelte-check@4.7.6        typescript ^5.0.0 || ^6.0.0
	//     typescript-eslint@8.71.1  typescript >=4.8.4 <6.1.0
	//     @sveltejs/kit@3.0.1       typescript ^6.0.0
	// Re-read the ranges before bumping. `.github/dependabot.yml` skips 7 for the
	// same reason.
	//
	// SvelteKit 3 writes the base configuration to `$app/tsconfig` (in
	// node_modules), which carries the module and resolution options this file
	// used to set itself. It sets no `include`, so this file names what is checked.
	// The configuration files run in Node and are checked by `tsconfig.node.json`.
	// The service worker is a separate project with web-worker types
	// (`src/service-worker/tsconfig.json`), so it is excluded here.
	//
	// `noUncheckedIndexedAccess` types every indexed read as possibly absent. A
	// payload row or a lookup that is not there reaches a figure as `undefined`,
	// and code that assumes otherwise has to say so, with `!` or a fallback.
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["src", "test"],
	"exclude": ["src/service-worker"]
}
