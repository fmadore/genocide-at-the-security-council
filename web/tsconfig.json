{
	// TypeScript stays on 6.x on purpose. `typescript@latest` is 7.0.2 — the
	// native compiler — and what it offers is compile speed, which this project
	// does not feel: `svelte-check` covers 4,213 files in well under a second.
	// The two tools that would have to accept it still refuse it, and their own
	// peer ranges are the test rather than anyone's recollection. On 9 October
	// 2026:
	//     svelte-check@4.7.6        typescript ^5.0.0 || ^6.0.0
	//     typescript-eslint@8.69.0  typescript >=4.8.4 <6.1.0
	// Re-read both ranges before bumping.
	//
	// `noUncheckedIndexedAccess` types every indexed read as possibly absent. A
	// payload row or a lookup that is not there reaches a figure as `undefined`,
	// and code that assumes otherwise has to say so, with `!` or a fallback.
	"extends": "./.svelte-kit/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		"noUncheckedIndexedAccess": true
	}
}
