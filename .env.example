# Copy to `.env` and edit. `.env` is git-ignored — it is where anything specific
# to you or your machine belongs, so that nothing in the tracked repository
# identifies an account, a host or a home directory.
#
#     cp .env.example .env
#
# Read by scripts/cluster/env.sh. Values already set in the environment win, so
# `UNSC_MODEL=qwen3-4b sbatch ...` still overrides what is written here.
# $USER and $HOME are expanded.
#
# None of this is needed to run steps 00-05, 08 and 09 on a laptop.

# --- Where things live on the cluster --------------------------------------
# /home is 15 GB and backed up; /workdir is 3 TB, purged after 60 days, not
# backed up; /scratch is larger still and purged after 10 days. Code belongs on
# /home, everything large belongs on /workdir.

# UNSC_VENV=/workdir/$USER/unsc/venv
# HF_HOME=/workdir/$USER/unsc/hf_cache
# UNSC_DATA_STORE=/workdir/$USER/unsc/data

# Where finished outputs are copied so they survive the purge. Set to `off` to
# skip the copy.
# UNSC_ARCHIVE=$HOME/unsc-archive

# --- Cluster environment ----------------------------------------------------
# Check with `module -t avail python` before changing.
# UNSC_PYTHON_MODULE=python/3.12.4

# --- Run settings -----------------------------------------------------------
# A key from config/embedding_models.yml.
# UNSC_MODEL=qwen3-0.6b
# UNSC_STORAGE_DTYPE=float16

# Topic-comparison settings (step 07).
# UNSC_SAMPLE=20000
# UNSC_K=25
# UNSC_SEEDS=5

# --- Fetching results back (used by the local machine, not the cluster) -----
# An alias from your own ~/.ssh/config — see docs/CLUSTER.md.
# UNSC_SSH=festus
# UNSC_REMOTE_REPO=~/genocide-at-the-security-council
